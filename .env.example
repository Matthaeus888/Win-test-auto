# Google Sheets 연동 (scripts/sheets_sync) 환경변수 템플릿
# 실제 값을 채운 뒤 이 파일을 .env로 복사해서 사용하세요. .env는 절대 git에 커밋하지 마세요.
#
#   cp .env.example .env

# 서비스 계정 키(JSON) 파일의 로컬 경로 (필수)
GOOGLE_SERVICE_ACCOUNT_FILE=

# TC를 기록할 대상 Google Spreadsheet의 ID (URL의 /d/{ID}/edit 부분, 필수)
GOOGLE_SHEET_ID=

# TC를 기록할 워크시트(탭) 이름 (선택, 기본값 TC)
GOOGLE_WORKSHEET_NAME=TC

# Automation Judge 평가 결과를 기록할 대상 Google Spreadsheet의 ID (필수, judge-* 명령용)
# GOOGLE_SHEET_ID와는 별개의 Spreadsheet 문서여야 합니다(같은 문서의 다른 탭이 아님).
GOOGLE_JUDGE_SHEET_ID=

# Automation Judge 평가 결과를 기록할 워크시트(탭) 이름 (선택, 기본값 Automation Judge)
GOOGLE_JUDGE_WORKSHEET_NAME=Automation Judge

# PRD를 반영할 대상 Google Doc의 ID (URL의 /d/{ID}/edit 부분, 필수, scripts/docs_sync prd-sync용)
GOOGLE_PRD_DOC_ID=

# Roadmap을 반영할 대상 Google Doc의 ID (필수, scripts/docs_sync roadmap-sync용)
GOOGLE_ROADMAP_DOC_ID=
